{
  "name": "svn-revision-manager",
  "displayName": "SVN Revision Manager",
  "description": "Manage SVN revisions by organizing them into groups, viewing diffs, generating file lists, and more.",
  "version": "0.3.2",
  "publisher": "GooiYinHong",
  "icon": "media/Logo.jpg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["SCM Providers", "Other"],
  "keywords": [
    "svn",
    "source control",
    "subversion",
    "diff",
    "revision",
    "grouping",
    "history",
    "code review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gyh6001/svn-revision-manager.git"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "svnRevisionManagerSidebar",
          "title": "SVN Revision Manager",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "svnRevisionManagerSidebar": [
        {
          "id": "svnRevisionManagerView",
          "name": "Revisions"
        }
      ]
    },
    "commands": [
      {
        "command": "svnRevisionManager.addGroup",
        "title": "Add Group",
        "icon": "$(add)"
      },
      {
        "command": "svnRevisionManager.addRevisionToGroup",
        "title": "Add Revision to Group"
      },
      {
        "command": "svnRevisionManager.openOnDoubleClick",
        "title": "Open Diff"
      },
      {
        "command": "svnRevisionManager.deleteGroup",
        "title": "Delete Group",
        "icon": "$(trash)"
      },
      {
        "command": "svnRevisionManager.copyFileName",
        "title": "Copy File Name"
      },
      {
        "command": "svnRevisionManager.copyFilePathFull",
        "title": "Copy File Path + Filename"
      },
      {
        "command": "svnRevisionManager.renameGroup",
        "title": "Rename Group",
        "icon": "$(edit)"
      },
      {
        "command": "svnRevisionManager.deleteRevision",
        "title": "Delete Revision",
        "icon": "$(close)"
      },
      {
        "command": "svnRevisionManager.generateFileList",
        "title": "Generate File List",
        "icon": "$(list-unordered)"
      },
      {
        "command": "svnRevisionManager.lockFile",
        "title": "SVN: Lock File"
      },
      {
        "command": "svnRevisionManager.forceLockFile",
        "title": "SVN: Force Lock File"
      },
      {
        "command": "svnRevisionManager.unlockFile",
        "title": "SVN: Unlock File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "svnRevisionManager.addGroup",
          "when": "view == svnRevisionManagerView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "svnRevisionManager.deleteGroup",
          "when": "view == svnRevisionManagerView && viewItem == group",
          "group": "inline"
        },
        {
          "command": "svnRevisionManager.renameGroup",
          "when": "view == svnRevisionManagerView && viewItem == group",
          "group": "inline"
        },
        {
          "command": "svnRevisionManager.deleteRevision",
          "when": "view == svnRevisionManagerView && viewItem == revision",
          "group": "inline"
        },
        {
          "command": "svnRevisionManager.generateFileList",
          "when": "view == svnRevisionManagerView && viewItem == group",
          "group": "inline"
        },
        {
          "command": "svnRevisionManager.copyFileName",
          "when": "view == svnRevisionManagerView && viewItem == file",
          "group": "navigation"
        },
        {
          "command": "svnRevisionManager.copyFilePathFull",
          "when": "view == svnRevisionManagerView && viewItem == file",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "svnRevisionManager.lockFile",
          "group": "svn@1"
        },
        {
          "command": "svnRevisionManager.forceLockFile",
          "group": "svn@2"
        },
        {
          "command": "svnRevisionManager.unlockFile",
          "group": "svn@3"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SVN Revision Group Settings",
      "properties": {
        "svnRevisionGroup.workingFolder": {
          "type": "string",
          "default": "",
          "description": "Full path to your SVN working copy folder."
        },
        "svnRevisionGroup.svnPath": {
          "type": "string",
          "default": "svn",
          "description": "Full path to svn.exe. Example: C:/Program Files/svn/bin/svn.exe"
        },
        "svnRevisionGroup.dataPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to store extension data (revisions.json). Leave empty to use the default storage path: {default}"
        }
      }
    }
  }
}
